# 사용할 LLM: openai 또는 anthropic
LLM_PROVIDER=anthropic
# 비우면 기본 모델 (openai: gpt-5-mini, anthropic: claude-sonnet-5-5)
MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 워크스페이스에 묶이지 않은 Anthropic 키를 쓸 때만 입력 (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=

SEOUL_API_KEY=
# true면 날씨·혼잡도를 고정 응답으로 (키 없이 테스트/평가)
SEOULMATE_MOCK_TOOLS=true

TOUR_API_KEY=
